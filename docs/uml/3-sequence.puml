@startuml sequence
title Пруф — как проверяется одно утверждение («ИИ не судит ИИ»)
skinparam shadowing false
autonumber
actor Пользователь as U
participant "UI" as UI
participant "Пайплайн" as P
participant "Разбор\n(LLM)" as EXT #EEF0FF
participant "Реестры\nDOI/Crossref/OpenAlex" as REG #E3F6EA
participant "Источник\n(сайт/PDF)" as WEB
participant "Код:\nBM25 + числа" as CODE #E3F6EA
participant "Судья\n(LLM)" as J #EEF0FF

U -> UI : вставляет ответ ИИ / загружает курсовую
UI -> P : POST /api/check
P -> EXT : раздели на утверждения и источники
EXT --> P : JSON (+ regex-страховка: все URL/DOI и [n] — кодом)
UI <<-- P : SSE: «найдено 5 утверждений, 4 источника»

group Существует ли источник? — БЕЗ нейросети
  P -> REG : DOI зарегистрирован? есть ли работа с таким названием?
  alt не найден ни в одном реестре
    REG --> P : нет
    UI <<-- P : [красный] «Источник не существует» + реальные работы по теме
  else найден, но другие авторы/год/название
    UI <<-- P : [оранжевый] «Данные искажены» + что именно не совпало
  else пейвол / 403 / база не ответила
    UI <<-- P : [серый] «Нет доступа» (НЕ «фейк»)
  end
end

group Говорит ли источник это?
  P -> WEB : скачать текст
  P -> CODE : выбрать 10 лучших фрагментов\n(совпадающие слова + однотипные числа)
  P -> J : утверждение + фрагменты
  J --> P : вердикт + ДОСЛОВНАЯ цитата
  P -> CODE : цитата есть в тексте источника? (rapidfuzz ≥ 90)\nчисла цитаты есть в источнике?\nчисло утверждения = числу источника?
  alt цитата не найдена
    UI <<-- P : [серый] вердикт модели ОТБРОШЕН
  else числа не совпали
    UI <<-- P : [оранжевый] «В ответе ИИ 40% / В источнике 60%» + цитата
  else всё сошлось
    UI <<-- P : [зелёный] «Подтверждено цитатой»
  end
end

note over P, J
  Нет источника у утверждения →
  поиск подтверждений И опровержений,
  «подтверждено» только при официальном /
  научном / справочном источнике или 2 сайтах
end note
UI <<-- P : итог: заголовок, счётчики, матрица «уверенно ≠ доказано», ссылка /r/<id>
@enduml
