# --- LLM: gemini | groq | openai | openrouter | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=                # aistudio.google.com
GROQ_API_KEY=                  # console.groq.com
LLM_API_KEY=                   # key for openai / openrouter / anthropic
# Fast model for parsing, strongest for verdicts. Comma-separated fallback chain, across providers
# ("provider:model"): when one model's daily quota runs out, the next one takes over.
LLM_MODEL_EXTRACT=gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite,groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b
LLM_MODEL_JUDGE=gemini:gemini-3.6-flash,gemini:gemini-3.5-flash,gemini:gemini-3-flash-preview,groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,groq:openai/gpt-oss-20b
LLM_CONCURRENCY=2
# LLM_MODEL=                   # one model for both roles
# LLM_CONCURRENCY=             # parallel LLM calls (default: groq 1, others 4)

# --- Web search for claims without sources (without it: Wikipedia only)
TAVILY_API_KEY=
# --- Free key from openalex.org: anonymous OpenAlex search gets paused under load
OPENALEX_API_KEY=
# --- Contact for the Crossref/OpenAlex polite pool
CONTACT_EMAIL=you@example.com
# --- Support address shown in the site footer (optional)
SUPPORT_EMAIL=
