# --- LLM: gemini | groq | openai | openrouter | anthropic
LLM_PROVIDER=gemini
GEMINI_API_KEY=                # aistudio.google.com; for LLM_PROVIDER=gemini
LLM_API_KEY=                   # key for any other provider
# Fast model for parsing, strongest for verdicts. Comma-separated = fallbacks when a daily quota runs out.
LLM_MODEL_EXTRACT=gemini-3.5-flash-lite,gemini-3.1-flash-lite
LLM_MODEL_JUDGE=gemini-3.8-flash,gemini-flash-latest,gemini-3.5-flash
# LLM_MODEL=                   # one model for both roles
# LLM_CONCURRENCY=             # parallel LLM calls (default: groq 1, others 4)

# --- Web search for claims without sources (without it: Wikipedia only)
TAVILY_API_KEY=
# --- Free key from openalex.org: anonymous OpenAlex search gets paused under load
OPENALEX_API_KEY=
# --- Contact for the Crossref/OpenAlex polite pool
CONTACT_EMAIL=you@example.com
# --- Support address shown in the site footer (optional)
SUPPORT_EMAIL=
