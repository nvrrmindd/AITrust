# --- LLM (required). Any OpenAI-compatible provider or Anthropic.
# Cheapest fast option: Groq (free tier) -> LLM_PROVIDER=groq, LLM_MODEL=openai/gpt-oss-120b
LLM_PROVIDER=openai            # openai | groq | openrouter | anthropic
LLM_API_KEY=
LLM_MODEL=                     # empty = provider default (see backend/app/config.py)
# LLM_BASE_URL=                # only for a custom OpenAI-compatible endpoint

# --- Web search for claims without sources (optional; without it we search Wikipedia)
TAVILY_API_KEY=

# --- Contact for Crossref/OpenAlex polite pool (optional but recommended)
CONTACT_EMAIL=you@example.com
